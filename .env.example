DB_HOST=database.allinonesolution.uk
DB_PORT=3306
DB_USER=gauteng_health_assets_app
DB_PASSWORD=replace-with-your-database-password
DB_NAME=gauteng_health_assets
# Production uses an authenticated WebSocket TCP bridge; keep its token secret.
DB_GATEWAY_URL=wss://db-gateway.allinonesolution.uk/mysql
DB_GATEWAY_TOKEN=replace-with-a-random-32-byte-or-longer-token
APP_URL=http://localhost:3000
# Server-side Google Gemini key for photo text analysis. Never expose as NEXT_PUBLIC_*.
GEMINI_API_KEY=
# Optional PEM CA bundle override; the current database CA is bundled at
# database/mysql-ca.pem. Production connections validate the cert and hostname.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----..."

# Set these temporarily in .env.local to create the first Super Administrator:
# BOOTSTRAP_ADMIN_NAME=Your Name
# BOOTSTRAP_ADMIN_PERSAL_NUMBER=01234567
# BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-password-at-least-12-characters
